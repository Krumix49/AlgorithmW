cabal-version:      3.0
name:               algorithm-w-reimpl
version:            0.1.0.0
build-type:         Simple

executable algorithm-w
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
      Infer
      Parser
      Syntax
      Types
  build-depends:
      base >=4.18 && <5
    , containers
  default-language: Haskell2010
  ghc-options: -Wall
