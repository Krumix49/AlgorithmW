cabal-version:      3.0
name:               AlgorithmW
version:            0.1.0.0
build-type:         Simple

executable AlgorithmW
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
      Inference
      MonadStack
      Pretty
      Syntax
      TypeEnv
      Types
      Unification
  build-depends:
      base >=4.18 && <5
    , containers
    , mtl
    , pretty
    , transformers
  default-language: Haskell2010

executable AlgorithmW-user
  main-is:          MainUser.hs
  hs-source-dirs:   app, src
  other-modules:
      Inference
      MonadStack
      Pretty
      Syntax
      TypeEnv
      Types
      Unification
  build-depends:
      base >=4.18 && <5
    , containers
    , mtl
    , pretty
    , transformers
  default-language: Haskell2010
